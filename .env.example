# Optional: use Neon Postgres locally. Never put real credentials in this file.
# DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=verify-full
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=verify-full
# Without DATABASE_URL, the app uses local SQLite.
# DATABASE_PATH=/absolute/path/trailtalk.sqlite
# Set for self-hosted HTTPS. Automatic on Vercel.
# COOKIE_SECURE=true
